# EditorConfig — shared formatting for all contributors
# Why: open-source PRs come from many editors; without a shared style file,
# diffs fill with whitespace noise unrelated to the actual change.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4
max_line_length = 100
